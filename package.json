{
  "name": "@mrvl/attribr-react-native",
  "version": "0.2.1",
  "description": "Tier 1 JS-only Attribr client for React Native / Expo apps. No native module, no CocoaPods/Gradle dependency.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "peerDependencies": {
    "expo-application": "*",
    "expo-crypto": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "expo-application": "^57.0.2",
    "expo-crypto": "^57.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "attribr",
    "attribution",
    "react-native",
    "expo",
    "mrvl"
  ],
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  }
}
